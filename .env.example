# Development defaults. Replace every placeholder locally; never commit a real .env.
NODE_ENV=development
PORT=5000

# Supabase PostgreSQL — use the exact Session Pooler URI from Supabase → Connect.
# Keep this server-side only; URL-encode any special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Generate independent random values with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CRON_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Persistent private screenshot storage using Dropbox API v2.
OBJECT_STORAGE_PROVIDER=dropbox
DROPBOX_APP_KEY=replace-with-dropbox-app-key
DROPBOX_APP_SECRET=replace-with-dropbox-app-secret
DROPBOX_REFRESH_TOKEN=replace-with-dropbox-refresh-token
DROPBOX_ROOT_PATH=/FactionControl/screenshots
